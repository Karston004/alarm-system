<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".ui.scheduleList.ScheduleListFragment">

    <TextView
        android:id="@+id/scheduleListTitle"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/rounded_card"
        android:gravity="center"
        android:text="@string/schedule_list_title"
        android:textSize="24sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/rounded_card">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/scheduleRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp" />

        <Button
            android:id="@+id/addScheduleButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:text="+"
            android:textSize="32sp" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/serviceConfigBox"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/rounded_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/status_green" />

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/status_green" />

        </LinearLayout>

        <TextView
            android:id="@+id/serviceConfigText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/service_configuration_menu"
            android:textSize="14sp" />

        <Button
            android:id="@+id/serviceConfigButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="=" />

    </LinearLayout>

</LinearLayout>